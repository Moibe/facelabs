# venv
.venv/
venv/
__pycache__/
*.py[cod]

# Datos: NUNCA versionar imágenes de personas.
# El consentimiento cubre el experimento, no un repo git perpetuo.
# Se ignoran los ARCHIVOS pero se dejan pasar los directorios y sus .gitkeep,
# para que la estructura de carpetas exista al clonar en la maquina con GPU.
data/**
!data/**/
!data/**/.gitkeep
!data/README.md

# Manifiestos reales: los genera init-manifest a partir de data/, y sus rutas
# llevan nombres de archivo reales de las personas del experimento (mismo
# problema de privacidad que las fotos, aunque no tengan el pixel). Se versiona
# sólo el ejemplo, que usa nombres inventados.
manifests/*
!manifests/ejemplo.json

# Salidas del harness (regenerables desde data/ + manifests/)
out/*
!out/.gitkeep

# Modelos descargados por insightface (~300 MB, licencia no comercial)
models/

# Front: dependencias y build (web/.gitignore ya los cubre; esto es cinturón)
web/node_modules/
web/.svelte-kit/
web/build/
